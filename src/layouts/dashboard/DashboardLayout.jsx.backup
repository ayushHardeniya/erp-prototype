import { useState, useEffect } from 'react';
import { useAuth } from '../../context/AuthContext';
import {
  HomeIcon,
  UserGroupIcon,
  AcademicCapIcon,
  CurrencyRupeeIcon,
  ClipboardDocumentListIcon,
  BellIcon,
  Bars3Icon,
  XMarkIcon,
  CalendarIcon,
  BookOpenIcon,
  BuildingOffice2Icon,
  TruckIcon,
  LifebuoyIcon,
  Cog6ToothIcon,
  UserIcon,
  ArrowRightOnRectangleIcon,
} from '@heroicons/react/24/outline';
import { Link, useLocation } from 'react-router-dom';
import { motion } from 'framer-motion';

// Define navigation items with access control
const navigation = [
  { name: 'Dashboard', href: '/dashboard', icon: HomeIcon, allowedRoles: ['student', 'faculty', 'admin'] },
  { name: 'Students', href: '/students', icon: UserGroupIcon, allowedRoles: ['faculty', 'admin'] },
  { name: 'Attendance', href: '/attendance', icon: AcademicCapIcon, allowedRoles: ['student', 'faculty', 'admin'] },
  { name: 'Timetable', href: '/timetable', icon: CalendarIcon, allowedRoles: ['student', 'faculty', 'admin'] },
  { name: 'Exams & Results', href: '/exams-results', icon: ClipboardDocumentListIcon, allowedRoles: ['student', 'faculty', 'admin'] },
  { name: 'Fees & Payments', href: '/fees-payments', icon: CurrencyRupeeIcon, allowedRoles: ['student', 'admin'] },
  { name: 'Library', href: '/library', icon: BookOpenIcon, allowedRoles: ['student', 'faculty', 'admin'] },
  { name: 'Hostel', href: '/hostel', icon: BuildingOffice2Icon, allowedRoles: ['student', 'admin'] },
  { name: 'Notifications', href: '/notifications', icon: BellIcon, allowedRoles: ['student', 'faculty', 'admin'] },
  { name: 'Transport', href: '/transport', icon: TruckIcon, allowedRoles: ['student', 'admin'] },
  { name: 'Support', href: '/support', icon: LifebuoyIcon, allowedRoles: ['student', 'faculty', 'admin'] },
];

export default function DashboardLayout({ children }) {
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [notifications, setNotifications] = useState(3); // Example notification count
  const { user, userRole, userProfile, logout } = useAuth();
  const location = useLocation();
  
  const [currentTime, setCurrentTime] = useState(new Date());

  // Update time every minute
  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentTime(new Date());
    }, 60000);
    
    return () => clearInterval(timer);
  }, []);

  const isActive = (path) => {
    return location.pathname === path;
  };
  
  // Filter navigation items by user role
  const filteredNavigation = navigation.filter(
    item => !item.allowedRoles || item.allowedRoles.includes(userRole)
  );
  
  // Format the date for header display
  const formattedDate = new Intl.DateTimeFormat('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(currentTime);
  
  // Format time
  const formattedTime = currentTime.toLocaleTimeString([], { 
    hour: '2-digit', 
    minute: '2-digit',
    hour12: true
  });

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Mobile sidebar overlay */}
      <div
        className={`fixed inset-0 bg-gray-800 bg-opacity-75 z-40 transition-opacity lg:hidden ${
          sidebarOpen ? 'opacity-100' : 'opacity-0 pointer-events-none'
        }`}
        onClick={() => setSidebarOpen(false)}
      />

      {/* Sidebar for mobile */}
      <div
        className={`fixed inset-y-0 left-0 w-72 bg-white shadow-xl transform transition-transform lg:hidden z-50 ${
          sidebarOpen ? 'translate-x-0' : '-translate-x-full'
        }`}
      >
        <div className="flex flex-col h-full">
          {/* Logo area */}
          <div className="flex items-center justify-between h-16 px-6 bg-primary-600">
            <div className="flex items-center">
              <img src="/Solvix SIH.png" alt="Solvix Logo" className="h-8 w-auto" />
              <span className="text-xl font-bold text-white ml-3">Solvix</span>
            </div>
            <button
              onClick={() => setSidebarOpen(false)}
              className="text-white hover:text-gray-200"
            >
              <XMarkIcon className="h-6 w-6" />
            </button>
          </div>
          
          {/* User profile summary */}
          <div className="px-6 py-4 border-b border-gray-200">
            <div className="flex items-center">
              <div className="h-10 w-10 rounded-full bg-primary-200 flex items-center justify-center text-primary-600 font-semibold">
                {userProfile?.fullName ? userProfile.fullName.charAt(0).toUpperCase() : user?.email.charAt(0).toUpperCase()}
              </div>
              <div className="ml-3">
                <p className="text-sm font-medium text-gray-900">
                  {userProfile?.fullName || user?.email}
                </p>
                <p className="text-xs font-medium text-gray-500 capitalize">
                  {userRole}
                </p>
              </div>
            </div>
          </div>
          
          {/* Navigation */}
          <nav className="mt-4 px-3 space-y-1 overflow-y-auto flex-1">
            {filteredNavigation.map((item) => (
              <Link
                key={item.name}
                to={item.href}
                className={`group flex items-center px-3 py-3 text-base font-medium rounded-lg transition-colors ${
                  isActive(item.href)
                    ? 'bg-primary-50 text-primary-600'
                    : 'text-gray-700 hover:bg-gray-50 hover:text-primary-600'
                }`}
                onClick={() => setSidebarOpen(false)}
              >
                <item.icon
                  className={`mr-4 h-5 w-5 ${
                    isActive(item.href)
                      ? 'text-primary-600'
                      : 'text-gray-400 group-hover:text-primary-500'
                  }`}
                  aria-hidden="true"
                />
                {item.name}
              </Link>
            ))}
          </nav>
          
          {/* Footer links */}
          <div className="px-3 py-4 border-t border-gray-200">
            <Link
              to="/profile"
              className="group flex items-center px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 hover:text-primary-600"
            >
              <UserIcon className="mr-3 h-5 w-5 text-gray-400 group-hover:text-primary-500" />
              My Profile
            </Link>
            <Link
              to="/settings"
              className="group flex items-center px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 hover:text-primary-600"
            >
              <Cog6ToothIcon className="mr-3 h-5 w-5 text-gray-400 group-hover:text-primary-500" />
              Settings
            </Link>
            <button
              onClick={logout}
              className="w-full group flex items-center px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 hover:text-primary-600"
            >
              <ArrowRightOnRectangleIcon className="mr-3 h-5 w-5 text-gray-400 group-hover:text-primary-500" />
              Sign out
            </button>
          </div>
        </div>
      </div>

      {/* Static sidebar for desktop */}
      <div className="hidden lg:flex lg:w-72 lg:flex-col lg:fixed lg:inset-y-0">
        <div className="flex flex-col flex-grow bg-white shadow-lg overflow-y-auto">
          {/* Logo area */}
          <div className="flex items-center h-16 px-6 bg-primary-600">
            <img src="/Solvix SIH.png" alt="Solvix Logo" className="h-8 w-auto" />
            <span className="text-xl font-display font-bold text-white ml-3">Solvix</span>
          </div>
          
          {/* User profile summary */}
          <div className="px-6 py-4 border-b border-gray-200">
            <div className="flex items-center">
              <div className="h-10 w-10 rounded-full bg-primary-200 flex items-center justify-center text-primary-600 font-semibold">
                {userProfile?.fullName ? userProfile.fullName.charAt(0).toUpperCase() : user?.email.charAt(0).toUpperCase()}
              </div>
              <div className="ml-3">
                <p className="text-sm font-medium text-gray-900">
                  {userProfile?.fullName || user?.email}
                </p>
                <p className="text-xs font-medium text-gray-500 capitalize">
                  {userRole}
                </p>
              </div>
            </div>
          </div>
          
          {/* Navigation */}
          <nav className="mt-4 px-3 space-y-1 flex-1">
            {filteredNavigation.map((item) => (
              <Link
                key={item.name}
                to={item.href}
                className={`group flex items-center px-3 py-3 text-sm font-medium rounded-lg transition-colors ${
                  isActive(item.href)
                    ? 'bg-primary-50 text-primary-600'
                    : 'text-gray-700 hover:bg-gray-50 hover:text-primary-600'
                }`}
              >
                <item.icon
                  className={`mr-3 h-5 w-5 ${
                    isActive(item.href)
                      ? 'text-primary-600'
                      : 'text-gray-400 group-hover:text-primary-500'
                  }`}
                  aria-hidden="true"
                />
                {item.name}
              </Link>
            ))}
          </nav>
          
          {/* Footer links */}
          <div className="px-3 py-4 border-t border-gray-200">
            <Link
              to="/profile"
              className="group flex items-center px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 hover:text-primary-600"
            >
              <UserIcon className="mr-3 h-5 w-5 text-gray-400 group-hover:text-primary-500" />
              My Profile
            </Link>
            <Link
              to="/settings"
              className="group flex items-center px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 hover:text-primary-600"
            >
              <Cog6ToothIcon className="mr-3 h-5 w-5 text-gray-400 group-hover:text-primary-500" />
              Settings
            </Link>
            <button
              onClick={logout}
              className="w-full group flex items-center px-3 py-2 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50 hover:text-primary-600"
            >
              <ArrowRightOnRectangleIcon className="mr-3 h-5 w-5 text-gray-400 group-hover:text-primary-500" />
              Sign out
            </button>
          </div>
                    : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
                }`}
              >
                <item.icon
                  className={`mr-3 h-6 w-6 ${
                    isActive(item.href)
                      ? 'text-primary-600'
                      : 'text-gray-400 group-hover:text-gray-500'
                  }`}
                />
                {item.name}
              </Link>
            ))}
          </nav>
        </div>
      </div>

      {/* Main content */}
      <div className="lg:pl-64 flex flex-col flex-1">
        {/* Top navigation */}
        <div className="sticky top-0 z-10 flex-shrink-0 flex h-16 bg-white shadow">
          <button
            type="button"
            className="px-4 border-r border-gray-200 text-gray-500 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500 lg:hidden"
            onClick={() => setSidebarOpen(true)}
          >
            <span className="sr-only">Open sidebar</span>
            <Bars3Icon className="h-6 w-6" />
          </button>
          <div className="flex-1 px-4 flex justify-between">
            <div className="flex-1 flex items-center">
              {/* Add search bar or other controls here */}
            </div>
            <div className="ml-4 flex items-center md:ml-6 space-x-4">
              <button className="p-1 rounded-full text-gray-400 hover:text-gray-500">
                <span className="sr-only">View notifications</span>
                <BellIcon className="h-6 w-6" />
              </button>

              {/* Profile dropdown */}
              <div className="relative">
                <button
                  onClick={logout}
                  className="btn-secondary text-sm"
                >
                  Sign out
                </button>
              </div>
            </div>
          </div>
        </div>

        {/* Main content area */}
        <main className="flex-1">
          <div className="py-6">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              {children}
            </div>
          </div>
        </main>
      </div>
    </div>
  )
}